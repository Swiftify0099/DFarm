# DFarm Super Admin Web Environment Configuration

# Google Maps JavaScript API Key
# Required for:
# - Interactive dairy location picker
# - Places address autocomplete suggestions
# - Draggable map pin drop & repositioning
# - Reverse geocoding of coordinates to Indian postal addresses
#
# Google Cloud Console Prerequisites:
# 1. Maps JavaScript API
# 2. Places API
# 3. Geocoding API
VITE_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY

# Backend API URL (Optional - defaults to local or proxy)
VITE_API_URL=http://localhost:3000
