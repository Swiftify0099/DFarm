# ==============================================================================
# DFARM SUPER ADMIN PLATFORM WEB APPLICATION (.env.example)
# ==============================================================================
# Cloudflare Pages Project: dfarm-super-admin
# Framework Preset: Vite
# Root Directory: apps/dfarm-super-admin
# Build Command: npm run build
# Build Output Directory: dist

# Canonical Backend API Base URL (Required)
# Cloudflare Pages Environment Variable: VITE_API_BASE_URL
VITE_API_BASE_URL=https://dfarm-backend.onrender.com/api/v1

# Legacy alias (fallback if VITE_API_BASE_URL is unset)
VITE_API_URL=https://dfarm-backend.onrender.com/api/v1

# Google Maps JavaScript API Key (Optional in local dev, Recommended in production)
# Required for:
# - Interactive dairy location picker
# - Places address autocomplete suggestions
# - Draggable map pin drop & repositioning
# - Reverse geocoding of coordinates to Indian postal addresses
VITE_GOOGLE_MAPS_API_KEY=AIzaSyYourActualGoogleMapsApiKeyPlaceholder

# Dairy Admin Portal URL (Used for activation completion redirect links)
# In local dev: http://localhost:5174
# In Cloudflare Pages Production: https://dairy.dfarm.in
VITE_DAIRY_ADMIN_URL=https://dairy.dfarm.in
