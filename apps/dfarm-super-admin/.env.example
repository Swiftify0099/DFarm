# ==============================================================================
# DFARM SUPER ADMIN PLATFORM WEB APPLICATION (.env.example)
# ==============================================================================
# Cloudflare Pages Project: dfarm-super-admin
# Framework Preset: Vite
# Root Directory: apps/dfarm-super-admin
# Build Command: npm run build
# Build Output Directory: dist

# Canonical Backend API Base URL (Required)
# In local dev: http://localhost:4000/api/v1
# In Cloudflare Pages Preview: https://api.dfarm.in/api/v1 (or preview backend instance)
# In Cloudflare Pages Production: https://api.dfarm.in/api/v1
VITE_API_BASE_URL=http://localhost:4000/api/v1

# Legacy alias (optional, fallback if VITE_API_BASE_URL is unset)
# VITE_API_URL=http://localhost:4000/api/v1

# Google Maps JavaScript API Key (Optional in local dev, Recommended in production)
# Required for:
# - Interactive dairy location picker
# - Places address autocomplete suggestions
# - Draggable map pin drop & repositioning
# - Reverse geocoding of coordinates to Indian postal addresses
# Google Cloud Console Prerequisites: Maps JavaScript API, Places API, Geocoding API
VITE_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY

# Dairy Admin Portal URL (Optional - used for activation completion redirect links)
# In local dev: http://localhost:5174
# In Cloudflare Pages Preview: https://dfarm-dairy-admin.pages.dev
# In Cloudflare Pages Production: https://dairy.dfarm.in
VITE_DAIRY_ADMIN_URL=http://localhost:5174
