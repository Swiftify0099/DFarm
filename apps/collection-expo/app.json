{
  "expo": {
    "name": "DFarm Collection Counter",
    "slug": "dfarm-collection-expo",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "scheme": "dfarmcollection",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dfarm.collection"
    },
    "android": {
      "package": "com.dfarm.collection",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#121212"
      },
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "CAMERA",
        "BLUETOOTH",
        "BLUETOOTH_ADMIN",
        "BLUETOOTH_CONNECT",
        "BLUETOOTH_SCAN",
        "NFC",
        "RECEIVE_BOOT_COMPLETED"
      ]
    },
    "plugins": [
      "expo-secure-store",
      "expo-sqlite",
      "react-native-nfc-manager"
    ],
    "extra": {
      "eas": {
        "projectId": "dfarm-collection-expo"
      }
    }
  }
}
