# ==============================================================================
# DFARM - SMART DAIRY MANAGEMENT SYSTEM
# ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to '.env' in your local environment for development.
# 2. NEVER commit '.env' or real secrets to the repository.
# 3. All variables marked [SERVER-ONLY] MUST NEVER be bundled into frontend
#    web apps, Android APKs, or mobile client bundles.
# 4. Values provided below are non-functional placeholders.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & RUNTIME ENVIRONMENT
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000/api/v1
APP_NAME=DFarm-SmartDairy
DEFAULT_CENTER_ID=center-001
TIMEZONE=Asia/Kolkata

# ------------------------------------------------------------------------------
# 2. SUPABASE POSTGRESQL & SERVICE CONFIGURATION [SERVER-ONLY]
# ------------------------------------------------------------------------------
# Supabase project URL (used for internal server API calls and PostgREST)
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Service Role Key: ELEVATED PRIVILEGES (Bypasses Row Level Security)
# CRITICAL: SERVER-SIDE ONLY. NEVER EXPOSE TO CLIENT BUNDLES OR APKS.
SUPABASE_SERVICE_ROLE_KEY=eyJh...placeholder_supabase_service_role_key...

# Direct PostgreSQL Connection String for Server ORM / Migrations
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?sslmode=require
DATABASE_URL=postgresql://postgres.your-ref:your-password@aws-0-region.pooler.supabase.com:6543/postgres

# Direct connection for running migrations (session mode / port 5432)
DIRECT_URL=postgresql://postgres:your-password@db.your-ref.supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# 2B. MULTI-TENANT POSTGRESQL & PROVISIONING CONFIGURATION [SERVER-ONLY]
# ------------------------------------------------------------------------------
# Central Control Plane Database Connection URI (defaults to DATABASE_URL if unset)
CENTRAL_DATABASE_URL=postgresql://postgres.your-ref:your-password@aws-0-region.pooler.supabase.com:6543/postgres

# PostgreSQL Provisioner Connection URI (used for CREATE DATABASE provisioning)
DATABASE_PROVISIONER_URL=postgresql://postgres:your-admin-password@db.your-ref.supabase.co:5432/postgres

# Master encryption key for tenant database credentials at rest (AES-256-GCM)
# Must be at least 32 characters
TENANT_DB_ENCRYPTION_KEY=placeholder_minimum_32_character_tenant_db_encryption_key

# Tenant Connection Pool Management & Budgets
TENANT_POOL_MAX=5
TENANT_POOL_IDLE_TIMEOUT_MS=30000
TENANT_POOL_CONNECTION_TIMEOUT_MS=5000
DATABASE_TLS_MODE=prefer

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & JWT CONFIGURATION [SERVER-ONLY]
# ------------------------------------------------------------------------------
JWT_SECRET=placeholder_minimum_32_character_random_jwt_secret
JWT_EXPIRATION_HOURS=24
JWT_REFRESH_EXPIRATION_DAYS=30
SUPERVISOR_SESSION_TIMEOUT_MINUTES=480

# ------------------------------------------------------------------------------
# 4. DATA ENCRYPTION AT REST & BIOMETRIC TEMPLATE KEYS [SERVER-ONLY]
# ------------------------------------------------------------------------------
# AES-256 Key for encrypting biometric template vectors and sensitive PII at rest
# 32-byte hexadecimal string (64 hex chars; generate with: openssl rand -hex 32)
DATA_ENCRYPTION_KEY_HEX=placeholder_64_hex_character_aes256_data_encryption_key

# Salt string used for hashing sensitive identification parameters
IDENTIFICATION_SALT=placeholder_identification_salt_value

# ------------------------------------------------------------------------------
# 5. OTP PROVIDER (CUSTOMER & SUPERVISOR VERIFICATION) [SERVER-ONLY]
# ------------------------------------------------------------------------------
OTP_PROVIDER=msg91
OTP_API_KEY=placeholder_otp_provider_api_key
OTP_SENDER_ID=DFARMS
OTP_TEMPLATE_ID=placeholder_dlt_approved_template_id
OTP_EXPIRY_SECONDS=300

# ------------------------------------------------------------------------------
# 6. WHATSAPP BUSINESS API (COLLECTION SLIPS & STATEMENTS) [SERVER-ONLY]
# ------------------------------------------------------------------------------
WHATSAPP_ENABLED=false
WHATSAPP_API_URL=https://graph.facebook.com/v21.0
WHATSAPP_ACCESS_TOKEN=placeholder_whatsapp_access_token
WHATSAPP_PHONE_NUMBER_ID=placeholder_whatsapp_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=placeholder_whatsapp_waba_id
WHATSAPP_WEBHOOK_VERIFY_TOKEN=placeholder_whatsapp_webhook_verify_token
WHATSAPP_APP_SECRET=placeholder_whatsapp_app_secret_for_hmac_sha256
WHATSAPP_DAILY_SLIP_TEMPLATE=dfarm_daily_collection_slip
WHATSAPP_MONTHLY_BILL_TEMPLATE=dfarm_monthly_settlement_statement

# ------------------------------------------------------------------------------
# 7. NOTIFICATION PROVIDER (FIREBASE CLOUD MESSAGING) [SERVER-ONLY]
# ------------------------------------------------------------------------------
FCM_PROJECT_ID=dfarm-smart-dairy
FCM_CLIENT_EMAIL=firebase-adminsdk@dfarm-smart-dairy.iam.gserviceaccount.com
FCM_PRIVATE_KEY="placeholder_firebase_service_account_private_key_pem"

# ------------------------------------------------------------------------------
# 8. EMAIL SERVICE (SMTP / PRIMARY DAIRY ADMIN ACTIVATION INVITATIONS) [SERVER-ONLY]
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="DFarm Platform <noreply@dfarm.in>"
PUBLIC_WEB_URL=http://localhost:5173
PUBLIC_ACTIVATION_URL=http://localhost:5173/activate

# ------------------------------------------------------------------------------
# 9. PAYMENT & SETTLEMENT GATEWAY (FUTURE BOUNDARY) [SERVER-ONLY]
# ------------------------------------------------------------------------------
PAYMENT_GATEWAY_PROVIDER=razorpay_payouts
PAYMENT_GATEWAY_KEY_ID=placeholder_payment_key_id
PAYMENT_GATEWAY_KEY_SECRET=placeholder_payment_key_secret
PAYMENT_ACCOUNT_NUMBER=placeholder_virtual_account_or_payout_account

# ------------------------------------------------------------------------------
# 10. PUBLIC CLIENT ENVIRONMENT VARIABLES (VITE / EXPO / REACT)
# Safe to expose in frontend bundles and mobile applications
# ------------------------------------------------------------------------------
# Admin Web Dashboard (Vite prefix: VITE_)
VITE_API_BASE_URL=http://localhost:4000/api/v1
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJh...placeholder_public_supabase_anon_key...
VITE_DEFAULT_CENTER_ID=center-001

# Customer Mobile App & Registration App (Expo prefix: EXPO_PUBLIC_)
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:4000/api/v1
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJh...placeholder_public_supabase_anon_key...
EXPO_PUBLIC_DEFAULT_CENTER_ID=center-001
EXPO_PUBLIC_FACE_MODEL_VERSION=mobilefacenet_v1.0.0

