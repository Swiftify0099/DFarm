{
  "name": "dfarm-monorepo",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "DFarm - Smart Dairy Management System Monorepo",
  "workspaces": [
    "packages/shared-types",
    "packages/shared-validation",
    "packages/database",
    "services/backend",
    "apps/dfarm-collection-app",
    "apps/dfarm-customer-app",
    "apps/dfarm-dairy-admin",
    "apps/dfarm-super-admin"
  ],
  "scripts": {
    "dev": "node scripts/run-all.js all",
    "dev:all": "node scripts/run-all.js all",
    "dev:web": "node scripts/run-all.js web",
    "dev:dairy-admin": "npm run dev --workspace=apps/dfarm-dairy-admin",
    "dev:super-admin": "npm run dev --workspace=apps/dfarm-super-admin",
    "dev:collection": "npm run dev --workspace=apps/dfarm-collection-app",
    "dev:customer": "npm run start --workspace=apps/dfarm-customer-app",
    "dev:customer:web": "npm run web --workspace=apps/dfarm-customer-app",
    "dev:customer:android": "npm run android --workspace=apps/dfarm-customer-app",
    "dev:backend": "node services/backend/dist/server.js",
    "dev:hub": "node scripts/dev-server.js",
    "start": "node services/backend/dist/server.js",
    "start:backend": "node services/backend/dist/server.js",
    "start:web": "node scripts/dev-server.js",
    "start:customer": "npm run start --workspace=apps/dfarm-customer-app",
    "start:customer:tunnel": "npm run tunnel --workspace=apps/dfarm-customer-app",
    "start:customer:clear": "npm run start:clear --workspace=apps/dfarm-customer-app",
    "start:customer:android": "npm run android --workspace=apps/dfarm-customer-app",
    "build": "npm run --workspaces build",
    "build:backend": "npm run build --workspace=packages/shared-types --workspace=packages/shared-validation --workspace=packages/database --workspace=services/backend",
    "lint": "npm run --workspaces lint",
    "format": "prettier --write \"**/*.{ts,js,json,md,sql}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,md,sql}\"",
    "test": "npm run --workspaces test",
    "db:validate": "npm run --workspace=packages/database test:validate",
    "db:test": "npm run --workspace=packages/database test",
    "db:seed-admin": "node scripts/seed-super-admin.js",
    "supabase": "supabase"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/node": "^22.10.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "eslint": "^9.16.0",
    "onnxruntime-node": "^1.31.1",
    "pg-mem": "^3.0.14",
    "prettier": "^3.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "supabase": "^3.1.0",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "json5": "^2.2.3"
  }
}
